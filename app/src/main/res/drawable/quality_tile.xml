<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/quality_surface" /><corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/quality_accent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#E5F2FC" /><corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/quality_accent" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/quality_surface" /><corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/quality_border" /></shape>
    </item>
</selector>
