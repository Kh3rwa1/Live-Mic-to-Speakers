<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/studio_soft" />
            <stroke android:width="2dp" android:color="@color/studio_blue" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/studio_surface" />
            <stroke android:width="1dp" android:color="@color/studio_line" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
