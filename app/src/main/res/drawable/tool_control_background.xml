<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#ECEBE8"/><corners android:radius="12dp"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#E5F2FC"/><stroke android:width="3dp" android:color="@color/quality_accent"/><corners android:radius="12dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#E5F2FC"/><stroke android:width="2dp" android:color="@color/quality_accent"/><corners android:radius="12dp"/></shape></item>
    <item><shape><solid android:color="@color/quality_surface"/><stroke android:width="1dp" android:color="@color/quality_border"/><corners android:radius="12dp"/></shape></item>
</selector>
