<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/studio_soft"/><stroke android:width="3dp" android:color="@color/studio_ink"/><corners android:radius="8dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/studio_soft"/><stroke android:width="2dp" android:color="@color/studio_blue"/><corners android:radius="8dp"/></shape></item>
    <item><shape><solid android:color="@android:color/white"/><stroke android:width="1dp" android:color="@color/studio_blue"/><corners android:radius="8dp"/></shape></item>
</selector>
