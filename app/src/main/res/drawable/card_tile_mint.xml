<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass: ice tint melting to white with a chrome edge. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#A9CFF3">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E3D6EBFD"
                android:endColor="#F7FCFF" />
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="#D9FFFFFF" />
        </shape>
    </item>
</ripple>
