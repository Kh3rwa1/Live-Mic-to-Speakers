<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_pastel_mesh">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/iv_back"
            style="@style/ToolControlCircleBack"
            android:contentDescription="@string/tool_back"
            android:src="@drawable/tool_back"
            app:tint="@color/quality_text" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

        <!-- Header Area: Settings title + 3D Purple Gear in circular stage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/tool_settings_title"
                    android:textColor="@color/quality_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/settings_make_it_yours"
                    android:textColor="@color/quality_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="8dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_stage_lavender"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/art_3d_gear" />
            </FrameLayout>
        </LinearLayout>

        <!-- Card 1: Privacy -->
        <LinearLayout
            android:id="@+id/rl_privacy_policy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_white_elevated"
            android:clickable="true"
            android:contentDescription="@string/settings_privacy"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_squircle_lavender_soft">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_privacy_shield" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/settings_privacy"
                android:textColor="@color/quality_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_indigo" />
        </LinearLayout>

        <!-- Card 2: Preferences -->
        <LinearLayout
            android:id="@+id/tool_privacy_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_white_elevated"
            android:clickable="true"
            android:contentDescription="@string/settings_preferences"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_squircle_mint_soft">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sliders_dark" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/settings_preferences"
                android:textColor="@color/quality_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_indigo" />
        </LinearLayout>

        <!-- Card: Audio Input Profile -->
        <LinearLayout
            android:id="@+id/card_audio_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_white_elevated"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_squircle_lavender_soft">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_mic_white"
                        app:tint="@color/quality_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/settings_audio_profile_title"
                        android:textColor="@color/quality_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/settings_audio_profile_desc"
                        android:textColor="@color/quality_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rg_audio_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_profile_low_latency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:buttonTint="@color/quality_accent"
                    android:contentDescription="@string/settings_profile_low_latency_title"
                    android:text="@string/settings_profile_low_latency_title"
                    android:textColor="@color/quality_text"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/settings_profile_low_latency_desc"
                    android:textColor="@color/quality_secondary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_profile_balanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:buttonTint="@color/quality_accent"
                    android:contentDescription="@string/settings_profile_balanced_title"
                    android:text="@string/settings_profile_balanced_title"
                    android:textColor="@color/quality_text"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/settings_profile_balanced_desc"
                    android:textColor="@color/quality_secondary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_profile_noisy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:buttonTint="@color/quality_accent"
                    android:contentDescription="@string/settings_profile_noisy_title"
                    android:text="@string/settings_profile_noisy_title"
                    android:textColor="@color/quality_text"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/settings_profile_noisy_desc"
                    android:textColor="@color/quality_secondary"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Card 3: Share App -->
        <LinearLayout
            android:id="@+id/rl_share_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_white_elevated"
            android:clickable="true"
            android:contentDescription="@string/settings_share_app_title"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_squircle_peach_soft">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_share_coral" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/settings_share_app_title"
                android:textColor="@color/quality_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_indigo" />
        </LinearLayout>

        <!-- Card 4: Rate App -->
        <LinearLayout
            android:id="@+id/rl_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_white_elevated"
            android:clickable="true"
            android:contentDescription="@string/settings_rate_app_title"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_squircle_yellow_soft">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star_gold" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/settings_rate_app_title"
                android:textColor="@color/quality_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_indigo" />
        </LinearLayout>

        <!-- Card 5: About -->
        <LinearLayout
            android:id="@+id/rl_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_white_elevated"
            android:clickable="true"
            android:contentDescription="@string/settings_about"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_squircle_lavender_soft">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info_purple" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/settings_about"
                android:textColor="@color/quality_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_indigo" />
        </LinearLayout>

        <!-- Bottom Row: Handwritten Script "Better Listening Everyday" -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="42dp"
                android:layout_alignParentEnd="true"
                android:scaleType="fitEnd"
                android:src="@drawable/ic_script_better_listening"
                android:importantForAccessibility="no" />
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<!-- Collapsible Ad View -->
<LinearLayout
    android:id="@+id/nativeLay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical" />
</LinearLayout>
