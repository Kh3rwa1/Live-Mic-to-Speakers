<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pastel_mesh"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false">

        <ImageButton
            android:id="@+id/iv_back"
            style="@style/ToolControlCircleBack"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/tool_back"
            android:src="@drawable/tool_back"
            app:tint="@color/quality_text" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <!-- Super Header Kicker: "RECORD MODE" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.12"
                android:text="@string/kicker_record_mode"
                android:textColor="#0B6FD6"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Title: Record Audio -->
            <TextView
                android:id="@+id/tv_title"
                style="@style/ToolTitle"
                android:layout_marginTop="2dp"
                android:text="@string/quality_record_title"
                android:textColor="@color/quality_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Central Hero Stage with Purple Animated Soundwave + Condenser Mic -->
            <FrameLayout
                android:id="@+id/layout_mic_hero"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:clickable="true"
                android:focusable="false"
                android:importantForAccessibility="no">

                <!-- Wide Purple Lottie Waveform spanning horizontally -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_record_wave"
                    android:layout_width="280dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:lottie_fileName="lottie_wave_record.json"
                    app:lottie_loop="true"
                    app:lottie_autoPlay="true" />

                <!-- Interactive Visualizer Canvas (Compatibility) -->
                <com.word.way.view.InteractiveWaveVisualizerView
                    android:id="@+id/visualizer_record"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <!-- Center 3D Condenser Studio Mic with Red Pop Filter -->
                <ImageView
                    android:id="@+id/iv_mic"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:contentDescription="@string/tool_start_recording"
                    android:focusable="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/hero_mic_bubble_3d" />
            </FrameLayout>

            <!-- Digital Timer Area (Floating White Rounded Capsule Card) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_timer_card_capsule"
                android:elevation="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/tool_timer_initial"
                    android:textColor="@color/quality_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_timer_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:letterSpacing="0.04"
                    android:text="@string/tool_ready_to_record"
                    android:textColor="#E11D48"
                    android:textSize="11.5sp"
                    android:accessibilityLiveRegion="polite"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Bottom Dock Controls Row (Gear, Large Coral Record Button, Play) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Left: Gear Circle Button -->
                <ImageButton
                    android:id="@+id/iv_history"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:layout_marginEnd="32dp"
                    android:background="@drawable/btn_circle_dock_control"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="2dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tool_history"
                    android:contentDescription="@string/tool_saved" />

                <!-- Center: Large Coral Record Circle Button (76dp) -->
                <ImageButton
                    android:id="@+id/iv_start_stop_new"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/btn_circle_record_coral"
                    android:clickable="true"
                    android:contentDescription="@string/tool_start_recording"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_record_circle_white" />

                <!-- Right: Play Circle Button -->
                <ImageButton
                    android:id="@+id/iv_play"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="32dp"
                    android:background="@drawable/btn_circle_dock_control"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="2dp"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play_dark"
                    android:contentDescription="@string/tool_play_last" />
            </LinearLayout>

            <!-- Record Action Label & Status Feedback -->
            <TextView
                android:id="@+id/tv_start_stop_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="@string/tool_start"
                android:textColor="@color/quality_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/studio_feedback"
                style="@style/ToolBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="@string/studio_ready"
                android:textColor="@color/quality_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_record_status_desc"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/tool_record_status_help"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Collapsible Ad Container at the Bottom -->
    <LinearLayout
        android:id="@+id/nativeLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical" />
</LinearLayout>
