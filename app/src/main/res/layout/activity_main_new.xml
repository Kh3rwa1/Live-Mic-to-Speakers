<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_pastel_mesh">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/quality_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/quality_home_title"
                android:textColor="@color/quality_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- 2x2 Grid Menu with Native Ad in Between -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <!-- Row 1: Live Mic & Hold to Speak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- Card 1: Live Microphone (Mint) -->
                    <LinearLayout
                        android:id="@+id/cv_live_microphone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="144dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/card_tile_mint"
                        android:clickable="true"
                        android:focusable="true"
                        android:descendantFocusability="blocksDescendants"
                        android:elevation="6dp"
                        android:gravity="center"
                        android:importantForAccessibility="yes"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="18dp"
                        android:contentDescription="@string/quality_live_title">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginBottom="8dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_3d_mic" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:text="@string/quality_live_title"
                            android:textAlignment="center"
                            android:textColor="@color/quality_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <!-- Card 2: Hold to Speak (Peach) -->
                    <LinearLayout
                        android:id="@+id/cv_hold_to_speak"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="144dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/card_tile_peach"
                        android:clickable="true"
                        android:focusable="true"
                        android:descendantFocusability="blocksDescendants"
                        android:elevation="6dp"
                        android:gravity="center"
                        android:importantForAccessibility="yes"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="18dp"
                        android:contentDescription="@string/quality_hold_title">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginBottom="8dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_3d_megaphone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:text="@string/quality_hold_title"
                            android:textAlignment="center"
                            android:textColor="@color/quality_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>

                <!-- AdMob Native Advance Ad Container (Between Rows) -->
                <LinearLayout
                    android:id="@+id/nativeLay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Row 2: Record Audio & Audio Library -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Card 3: Record Audio (Lavender) -->
                    <LinearLayout
                        android:id="@+id/cv_record_audio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="144dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/card_tile_lavender"
                        android:clickable="true"
                        android:focusable="true"
                        android:descendantFocusability="blocksDescendants"
                        android:elevation="6dp"
                        android:gravity="center"
                        android:importantForAccessibility="yes"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="18dp"
                        android:contentDescription="@string/quality_record_title">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginBottom="8dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_3d_soundwave" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:text="@string/quality_record_title"
                            android:textAlignment="center"
                            android:textColor="@color/quality_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <!-- Card 4: Audio Library (Yellow) -->
                    <LinearLayout
                        android:id="@+id/cv_music_list"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="144dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/card_tile_yellow"
                        android:clickable="true"
                        android:focusable="true"
                        android:descendantFocusability="blocksDescendants"
                        android:elevation="6dp"
                        android:gravity="center"
                        android:importantForAccessibility="yes"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="18dp"
                        android:contentDescription="@string/quality_music_title">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginBottom="8dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_3d_folder" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:text="@string/quality_music_title"
                            android:textAlignment="center"
                            android:textColor="@color/quality_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Flexible Space to Gracefully Fill Screen on Tall Devices -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:text="@string/quality_safety_note"
                android:textColor="@color/quality_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_regular"
                android:padding="8dp"
                android:text="@string/quality_settings"
                android:textColor="@color/quality_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
