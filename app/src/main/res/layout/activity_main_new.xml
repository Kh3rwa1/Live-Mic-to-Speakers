<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pastel_mesh"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/quality_headline"
            style="@style/StudioTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/quality_home_title" />

        <ImageButton
            android:id="@+id/tv_settings"
            style="@style/ToolControlCircleBack"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/quality_settings"
            android:src="@drawable/setting"
            app:tint="@color/studio_ink" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/StudioEyebrow"
                android:text="@string/studio_home_eyebrow" />

            <TextView
                style="@style/StudioBody"
                android:text="@string/quality_home_subtitle" />

            <TextView
                style="@style/StudioSectionTitle"
                android:text="@string/studio_home_tools" />

            <LinearLayout
                android:id="@+id/cv_live_microphone"
                style="@style/StudioAction"
                android:contentDescription="@string/quality_live_title">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/btn_squircle_mint"
                    android:importantForAccessibility="no"
                    android:padding="13dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tool_mic"
                        app:tint="@color/studio_ink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">
                    <TextView
                        style="@style/StudioBody"
                        android:layout_marginTop="0dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/quality_live_title"
                        android:textColor="@color/studio_ink"
                        android:textSize="18sp" />
                    <TextView
                        style="@style/StudioBody"
                        android:text="@string/studio_live_description"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/tool_next"
                    app:tint="@color/studio_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cv_hold_to_speak"
                style="@style/StudioAction"
                android:contentDescription="@string/quality_hold_title">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/btn_squircle_peach"
                    android:importantForAccessibility="no"
                    android:padding="13dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tool_record"
                        app:tint="@color/studio_ink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">
                    <TextView
                        style="@style/StudioBody"
                        android:layout_marginTop="0dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/quality_hold_title"
                        android:textColor="@color/studio_ink"
                        android:textSize="18sp" />
                    <TextView
                        style="@style/StudioBody"
                        android:text="@string/studio_hold_description"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/tool_next"
                    app:tint="@color/studio_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cv_record_audio"
                style="@style/StudioAction"
                android:contentDescription="@string/quality_record_title">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/btn_squircle_lavender"
                    android:importantForAccessibility="no"
                    android:padding="13dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tool_record"
                        app:tint="@color/studio_ink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">
                    <TextView
                        style="@style/StudioBody"
                        android:layout_marginTop="0dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/quality_record_title"
                        android:textColor="@color/studio_ink"
                        android:textSize="18sp" />
                    <TextView
                        style="@style/StudioBody"
                        android:text="@string/studio_record_description"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/tool_next"
                    app:tint="@color/studio_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cv_music_list"
                style="@style/StudioAction"
                android:contentDescription="@string/quality_music_title">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/btn_squircle_yellow"
                    android:importantForAccessibility="no"
                    android:padding="13dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tool_history"
                        app:tint="@color/studio_ink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">
                    <TextView
                        style="@style/StudioBody"
                        android:layout_marginTop="0dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/quality_music_title"
                        android:textColor="@color/studio_ink"
                        android:textSize="18sp" />
                    <TextView
                        style="@style/StudioBody"
                        android:text="@string/studio_library_description"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/tool_next"
                    app:tint="@color/studio_muted" />
            </LinearLayout>

            <TextView
                style="@style/StudioNotice"
                android:text="@string/quality_safety_note" />

            <LinearLayout
                android:id="@+id/nativeLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
