<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_pastel_mesh">

    <!-- Top Header Area: Equalizer + Mic to Speaker horizontally aligned -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_header_equalizer"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/header_branding"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quality_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/quality_home_title"
                android:textColor="@color/quality_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/quality_home_subtitle"
                android:textColor="@color/home_subtitle_text"
                android:textSize="11sp"
                android:letterSpacing="0.01"
                android:includeFontPadding="false" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/tv_settings"
            style="@style/ToolControlCircleBack"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/quality_settings"
            android:src="@drawable/setting"
            app:tint="@color/quality_text" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Row 1: Live Mic & Hold to Speak -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="112dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp">

                <!-- Card 1: Live Microphone (Mint) -->
                <LinearLayout
                    android:id="@+id/cv_live_microphone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:minHeight="112dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/card_tile_mint"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:clipToOutline="true"
                    android:contentDescription="@string/quality_live_title">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="48dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:padding="6dp"
                            android:src="@drawable/ic_home_live_mic"
                            android:importantForAccessibility="no" />

                        <!-- "● Live" Badge Pill -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_live_badge"
                            android:gravity="center_vertical"
                            android:paddingStart="6dp"
                            android:paddingEnd="8dp"
                            android:importantForAccessibility="no">

                            <View
                                android:layout_width="5dp"
                                android:layout_height="5dp"
                                android:background="@drawable/ic_live_dot" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/quality_live_badge"
                                android:textColor="#065F46"
                                android:textSize="9.5sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="@string/quality_live_title"
                                android:textColor="@color/quality_text"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/quality_live_subtitle"
                                android:textColor="@color/home_subtitle_text"
                                android:textSize="10sp"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/btn_home_circle_mint"
                            android:src="@drawable/ic_chevron_right_action"
                            android:padding="6dp"
                            app:tint="@android:color/white"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 2: Hold to Speak (Peach) -->
                <LinearLayout
                    android:id="@+id/cv_hold_to_speak"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:minHeight="112dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/card_tile_peach"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:clipToOutline="true"
                    android:contentDescription="@string/quality_hold_title">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="48dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:padding="6dp"
                            android:src="@drawable/ic_home_hold_speaker"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="@string/quality_hold_title"
                                android:textColor="@color/quality_text"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/quality_hold_subtitle"
                                android:textColor="@color/home_subtitle_text"
                                android:textSize="10sp"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/btn_home_circle_peach"
                            android:src="@drawable/ic_chevron_right_action"
                            android:padding="6dp"
                            app:tint="@android:color/white"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Record Audio & Audio Library -->
            <!-- Native Ad in between Row 1 and Row 2 -->
            <LinearLayout
                android:id="@+id/nativeLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical" />

            <!-- Row 2: Record Audio & Audio Library (continued below) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="112dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <!-- Card 3: Record Audio (Lavender) -->
                <LinearLayout
                    android:id="@+id/cv_record_audio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:minHeight="112dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/card_tile_lavender"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:clipToOutline="true"
                    android:contentDescription="@string/quality_record_title">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="48dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:padding="6dp"
                            android:src="@drawable/ic_home_record_mic"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="@string/quality_record_title"
                                android:textColor="@color/quality_text"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/quality_record_subtitle"
                                android:textColor="@color/home_subtitle_text"
                                android:textSize="10sp"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/btn_home_circle_lavender"
                            android:src="@drawable/ic_chevron_right_action"
                            android:padding="6dp"
                            app:tint="@android:color/white"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 4: Audio Library (Yellow) -->
                <LinearLayout
                    android:id="@+id/cv_music_list"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:minHeight="112dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/card_tile_yellow"
                    android:clickable="true"
                    android:focusable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:clipToOutline="true"
                    android:contentDescription="@string/quality_music_title">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="48dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:padding="6dp"
                            android:src="@drawable/ic_home_library_folder"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="@string/quality_music_title"
                                android:textColor="@color/quality_text"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/quality_music_subtitle"
                                android:textColor="@color/home_subtitle_text"
                                android:textSize="10sp"
                                android:includeFontPadding="false" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/btn_home_circle_yellow"
                            android:src="@drawable/ic_chevron_right_action"
                            android:padding="6dp"
                            app:tint="@android:color/white"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Safety Card: Start at low volume / Headphones are safer -->
            <LinearLayout
                android:id="@+id/card_volume_safety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_card_white_elevated"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:clipToOutline="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:contentDescription="@string/quality_safety_note">

                <!-- Blue Circle with Headphones Icon -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_badge_blue_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_headphones_dark"
                        app:tint="#2563EB"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/quality_safety_title"
                        android:textColor="@color/quality_text"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/quality_safety_subtitle"
                        android:textColor="@color/home_subtitle_text"
                        android:textSize="11.5sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right_action"
                    app:tint="#94A3B8"
                    android:importantForAccessibility="no" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
