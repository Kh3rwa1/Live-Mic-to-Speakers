<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/quality_canvas">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:paddingStart="24dp" android:paddingEnd="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_centerVertical="true" android:layout_marginEnd="56dp"
            android:text="@string/app_name" android:textColor="@color/quality_text"
            android:textSize="18sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/iv_back" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_preferences" android:tint="@color/quality_text"
            android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quality_settings" />
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/quality_headline" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/quality_home_title" android:textSize="24sp" android:textStyle="bold"
                android:textColor="@color/quality_text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
                android:text="@string/quality_home_subtitle" android:textSize="16sp"
                android:textColor="@color/quality_secondary" />
            <LinearLayout android:id="@+id/cv_live_microphone" style="@style/QualityTile"
                android:contentDescription="@string/quality_live_title">
                <TextView style="@style/QualityTileTitle" android:text="@string/quality_live_title" />
                <TextView style="@style/QualityTileBody" android:text="@string/quality_live_body" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cv_hold_to_speak" style="@style/QualityTile"
                android:contentDescription="@string/quality_hold_title">
                <TextView style="@style/QualityTileTitle" android:text="@string/quality_hold_title" />
                <TextView style="@style/QualityTileBody" android:text="@string/quality_hold_body" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cv_record_audio" style="@style/QualityTile"
                android:contentDescription="@string/quality_record_title">
                <TextView style="@style/QualityTileTitle" android:text="@string/quality_record_title" />
                <TextView style="@style/QualityTileBody" android:text="@string/quality_record_body" />
            </LinearLayout>
            <LinearLayout android:id="@+id/cv_music_list" style="@style/QualityTile"
                android:contentDescription="@string/quality_music_title">
                <TextView style="@style/QualityTileTitle" android:text="@string/quality_music_title" />
                <TextView style="@style/QualityTileBody" android:text="@string/quality_music_body" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/quality_safety_note"
                android:textSize="14sp" android:textColor="@color/quality_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/nativeLay" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_horizontal"
        android:orientation="vertical" />
</LinearLayout>
