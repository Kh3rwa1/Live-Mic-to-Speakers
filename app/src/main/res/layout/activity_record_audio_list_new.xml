<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/studio_canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <ImageButton android:id="@+id/iv_back" style="@style/ToolControlCircleBack"
            android:background="@drawable/library_button_background" android:elevation="0dp"
            android:src="@drawable/tool_back" app:tint="@color/studio_ink" android:contentDescription="@string/tool_back"/>
        <TextView android:id="@+id/tv_tittle" style="@style/StudioTitle" android:layout_width="0dp"
            android:layout_weight="1" android:layout_marginStart="16dp" android:textSize="22sp" android:text="@string/library_history_title"/>
    </LinearLayout>
    <androidx.appcompat.widget.SearchView android:id="@+id/search" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" android:contentDescription="@string/library_search_recordings"
        app:queryHint="@string/library_search_recordings"/>
    <TextView android:id="@+id/library_summary" style="@style/LibraryMetadata" android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" android:layout_marginBottom="8dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSongList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="16dp"/>
        <androidx.core.widget.NestedScrollView android:id="@+id/library_state_panel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:padding="24dp">
                <TextView android:id="@+id/noData" style="@style/StudioBody" android:text="@string/library_loading"
                    android:gravity="center" android:accessibilityLiveRegion="polite"/>
                <Button android:id="@+id/library_retry" style="@style/LibraryButton" android:layout_marginTop="16dp"
                    android:text="@string/library_retry" android:visibility="gone"/>
                <Button android:id="@+id/library_clear" style="@style/LibraryButton" android:layout_marginTop="16dp"
                    android:text="@string/library_clear_search" android:visibility="gone"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    <LinearLayout android:id="@+id/nativeLay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical"/>
</LinearLayout>
