<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pastel_mesh"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">
        <ImageButton
            android:id="@+id/iv_back"
            style="@style/ToolControlCircleBack"
            android:contentDescription="@string/tool_back"
            android:src="@drawable/tool_back"
            app:tint="@color/quality_text" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">
            <TextView
                style="@style/StudioEyebrow"
                android:text="@string/studio_player_eyebrow" />
            <TextView
                android:id="@+id/tv_tittle"
                style="@style/StudioTitle"
                android:layout_marginTop="8dp"
                android:text="@string/tool_player_title" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/studio_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="20dp">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottie_player_equalizer"
                    android:layout_width="112dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="lottie_equalizer.json"
                    app:lottie_loop="true" />
                <TextView
                    android:id="@+id/textViewTitle"
                    style="@style/StudioSectionTitle"
                    android:layout_marginTop="16dp"
                    android:gravity="center" />
                <TextView
                    android:id="@+id/textViewArtist"
                    style="@style/StudioBody"
                    android:gravity="center"
                    android:text="@string/tool_unknown_artist" />
                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:contentDescription="@string/tool_position"
                    android:minHeight="48dp"
                    android:progressTint="@color/studio_blue"
                    android:thumbTint="@color/studio_blue" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textViewElapsedTime"
                        style="@style/StudioBody"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:text="@string/tool_timer_initial"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/textViewDuration"
                        style="@style/StudioBody"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/tool_timer_initial"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/imageButtonPre"
                    style="@style/ToolControlMint"
                    android:layout_margin="6dp"
                    android:contentDescription="@string/tool_previous"
                    android:src="@drawable/tool_previous"
                    app:tint="@color/quality_text" />
                <ImageButton
                    android:id="@+id/imageButtonPlayPause"
                    style="@style/ToolControlPeach"
                    android:layout_margin="6dp"
                    android:contentDescription="@string/tool_play"
                    android:src="@drawable/tool_play"
                    app:tint="@color/quality_text" />
                <ImageButton
                    android:id="@+id/imageButtonNext"
                    style="@style/ToolControlLavender"
                    android:layout_margin="6dp"
                    android:contentDescription="@string/tool_next"
                    android:src="@drawable/tool_next"
                    app:tint="@color/quality_text" />
            </LinearLayout>
            <Button
                android:id="@+id/fab"
                style="@style/ToolTextButton"
                android:text="@string/tool_change_audio" />
            <TextView
                style="@style/StudioBody"
                android:text="@string/tool_foreground_note"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/nativeLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical" />
</LinearLayout>
