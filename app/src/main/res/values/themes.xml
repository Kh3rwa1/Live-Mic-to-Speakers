<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DecMictospeaker" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="TestStyleWithoutLineHeight" parent="@style/TextAppearance.AppCompat.Title">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TransparentBackground_dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="TransparentBackground" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="AlertDialogCustom" parent="@style/Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/bgcolor</item>
        <item name="android:colorAccent">@color/white</item>
    </style>
    <style name="MySeekBar" parent="@style/Widget.AppCompat.SeekBar">
        <item name="android:thumb">@drawable/seek_30</item>
        <item name="android:progressTint">@color/header_bg</item>
        <item name="android:progressBackgroundTint">#ff3f4250</item>
    </style>
    <style name="SearchViewTheme" parent="@style/Widget.AppCompat.SearchView">
        <item name="android:textColorHint">#80ffffff</item>
        <item name="android:tint">@color/white</item>
        <item name="android:editTextColor">@android:color/white</item>
        <item name="searchHintIcon">@drawable/ic_search</item>
        <item name="searchIcon">@drawable/ic_search</item>
    </style>
</resources>