<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Intentionally light: the pastel palette stays predictable in every system mode. -->
    <style name="Theme.DecMictospeaker" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/studio_blue</item>
        <item name="colorPrimaryVariant">@color/studio_blue_pressed</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/quality_accent</item>
        <item name="colorSecondaryVariant">@color/quality_accent</item>
        <item name="colorOnSecondary">@color/quality_on_accent</item>
        <item name="android:colorAccent">@color/quality_accent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:windowBackground">@drawable/bg_pastel_mesh</item>
    </style>

    <style name="TestStyleWithoutLineHeight" parent="@style/TextAppearance.AppCompat.Title">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TransparentBackground_dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="TransparentBackground" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="AlertDialogCustom" parent="@style/Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/bgcolor</item>
        <item name="android:colorAccent">@color/white</item>
    </style>
    <style name="MySeekBar" parent="@style/Widget.AppCompat.SeekBar">
        <item name="android:thumb">@drawable/seek_30</item>
        <item name="android:progressTint">@color/header_bg</item>
        <item name="android:progressBackgroundTint">#ff3f4250</item>
    </style>
    <style name="SearchViewTheme" parent="@style/Widget.AppCompat.SearchView">
        <item name="android:textColorHint">@color/quality_secondary</item>
        <item name="android:tint">@color/studio_blue</item>
        <item name="android:editTextColor">@color/quality_text</item>
        <item name="searchHintIcon">@drawable/ic_search</item>
        <item name="searchIcon">@drawable/ic_search</item>
    </style>
</resources>
