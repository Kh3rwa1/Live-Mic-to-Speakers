<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ToolTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">@color/quality_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="ToolBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/quality_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="ToolControl">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/tool_control_background</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="ToolControlCircleBack">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/btn_circle_white</item>
        <item name="android:elevation">1dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="ToolControlMint">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/btn_squircle_mint</item>
        <item name="android:elevation">2dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="ToolControlPeach">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">20dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/btn_squircle_peach</item>
        <item name="android:elevation">3dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="ToolControlLavender">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/btn_squircle_lavender</item>
        <item name="android:elevation">2dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="ToolTextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">@color/studio_blue</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/studio_secondary_button</item>
        <item name="android:elevation">0dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
